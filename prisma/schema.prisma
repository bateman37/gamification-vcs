// Esquema de datos de Gamification VCS - MVP-1A.
// Consulta docs/DATA_MODEL.md para la documentacion completa del modelo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ParticipantLevel {
  N0
  N1
  N2
}

/// Catalogo cerrado de KPI de Split 8 (ver src/domain/kpis/catalog.ts). El
/// orden de declaracion coincide con el orden de presentacion del catalogo.
enum KpiCode {
  SOLUTION_HUNTER
  DATA_EXPLORER
  VOICE_AMBASSADOR
  MASTER_CRAFTSMAN
  ESCALATION_TAMER
  STABILITY_GUARDIAN
  WORK_CHRONOMANCY
  STAR_WRITER
  ENTHUSIASTIC_STUDENT
  EXPERT_APPRENTICE
}

/// Persona: registro estable, reutilizable entre splits. No es lo mismo
/// que un participante: una persona puede no participar en ningun split,
/// o participar en varios con alias distintos en cada uno.
model Person {
  id        String   @id @default(uuid())
  fullName  String
  /// Correo normalizado (minusculas, sin espacios). Opcional pero unico.
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations SplitParticipant[]
}

/// Split: una edicion de la gamificacion periodica.
model Split {
  id            String      @id @default(uuid())
  name          String
  description   String?
  /// Fecha de inicio del split. Siempre un lunes. Se guarda como fecha de
  /// calendario (sin componente horario) para evitar desplazamientos de
  /// zona horaria.
  startDate     DateTime    @db.Date
  numberOfWeeks Int
  status        SplitStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  weeks        SplitWeek[]
  participants SplitParticipant[]
  kpiConfigs   SplitKpiConfig[]
}

/// Semana de un split. La identidad funcional es splitId + sequenceNumber,
/// nunca el numero de semana ISO del calendario.
model SplitWeek {
  id             String   @id @default(uuid())
  splitId        String
  /// Numero secuencial dentro del split: 1, 2, 3...
  sequenceNumber Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  split                    Split              @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participantsStartingHere SplitParticipant[] @relation("ParticipantStartWeek")

  @@unique([splitId, sequenceNumber])
}

/// Participante: relacion entre una persona y un split, con alias y nivel
/// propios de ese split.
model SplitParticipant {
  id        String           @id @default(uuid())
  splitId   String
  personId  String
  /// Alias tal como lo escribe el administrador.
  alias     String
  /// Alias normalizado (minusculas, sin espacios exteriores colapsados)
  /// usado exclusivamente para garantizar unicidad dentro del split.
  aliasNormalized String
  level     ParticipantLevel
  /// Numero de semana (dentro de este split) desde la que participa.
  startWeekSequenceNumber Int
  /// Preparado para el futuro cierre de participacion. No se usa todavia.
  endWeekSequenceNumber   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  split     Split     @relation(fields: [splitId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id])
  startWeek SplitWeek @relation("ParticipantStartWeek", fields: [splitId, startWeekSequenceNumber], references: [splitId, sequenceNumber])

  // Una persona solo puede aparecer una vez en un mismo split.
  @@unique([splitId, personId])
  // El alias normalizado debe ser unico dentro del split (no entre splits).
  @@unique([splitId, aliasNormalized])
}

/// Configuracion de un KPI del catalogo cerrado para un split concreto.
/// Cada split conserva su propia copia: un cambio futuro en los valores
/// predeterminados del catalogo no modifica silenciosamente la
/// configuracion de splits ya creados.
model SplitKpiConfig {
  id       String  @id @default(uuid())
  splitId  String
  kpiCode  KpiCode
  isActive Boolean @default(false)
  /// Maximo base del KPI. Siempre mayor que cero.
  baseMax  Decimal @db.Decimal(12, 4)
  /// Multiplicador aplicado a participantes de nivel N0. `null` significa
  /// que el nivel no es aplicable para este KPI, no que el multiplicador
  /// sea cero.
  multiplierN0 Decimal? @db.Decimal(12, 4)
  multiplierN1 Decimal? @db.Decimal(12, 4)
  multiplierN2 Decimal? @db.Decimal(12, 4)
  /// Parametros propios del tipo de calculo de este KPI (ver
  /// src/domain/kpis/catalog.ts). Nunca se acepta tal cual desde el
  /// navegador: se construye a partir de campos conocidos y se valida
  /// segun `kpiCode` antes de guardarse.
  parameters Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  split Split @relation(fields: [splitId], references: [id], onDelete: Cascade)

  // Un split tiene como mucho una configuracion por cada KPI del catalogo.
  @@unique([splitId, kpiCode])
}
