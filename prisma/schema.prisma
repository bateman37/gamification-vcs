// Esquema de datos de Gamification VCS - MVP-1A.
// Consulta docs/DATA_MODEL.md para la documentacion completa del modelo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ParticipantLevel {
  N0
  N1
  N2
}

/// Catalogo cerrado de KPI de Split 8 (ver src/domain/kpis/catalog.ts). El
/// orden de declaracion coincide con el orden de presentacion del catalogo.
enum KpiCode {
  SOLUTION_HUNTER
  DATA_EXPLORER
  VOICE_AMBASSADOR
  MASTER_CRAFTSMAN
  ESCALATION_TAMER
  STABILITY_GUARDIAN
  WORK_CHRONOMANCY
  STAR_WRITER
  ENTHUSIASTIC_STUDENT
  EXPERT_APPRENTICE
}

/// Persona: registro estable, reutilizable entre splits. No es lo mismo
/// que un participante: una persona puede no participar en ningun split,
/// o participar en varios con alias distintos en cada uno.
model Person {
  id        String   @id @default(uuid())
  fullName  String
  /// Correo normalizado (minusculas, sin espacios). Opcional pero unico.
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations   SplitParticipant[]
  user             User?
  publishedResults PublishedParticipantWeeklyResult[]
  newsDeliveries   NewsDelivery[]
}

enum UserRole {
  ADMIN
  PARTICIPANT
}

/// Cuenta de acceso local (`0.6.0` / MVP-1C, ver docs/AUTHENTICATION.md).
/// Un administrador puede no estar vinculado a ninguna persona; un
/// participante debe estar vinculado uno a uno con una `Person` para poder
/// ver su propio detalle. La contrasena nunca se guarda en claro ni con
/// cifrado reversible: solo su hash (bcrypt).
model User {
  id                 String   @id @default(uuid())
  /// Correo normalizado (minusculas, sin espacios), usado para iniciar sesion.
  email              String   @unique
  passwordHash       String
  role               UserRole
  personId           String?  @unique
  isActive           Boolean  @default(true)
  /// Obliga a cambiar la contrasena temporal en el primer acceso.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  person           Person?           @relation(fields: [personId], references: [id], onDelete: Restrict)
  publications     WeekPublication[]
  createdNewsItems NewsItem[]
  newsDeliveries   NewsDelivery[]
}

/// Split: una edicion de la gamificacion periodica.
model Split {
  id            String      @id @default(uuid())
  name          String
  description   String?
  /// Fecha de inicio del split. Siempre un lunes. Se guarda como fecha de
  /// calendario (sin componente horario) para evitar desplazamientos de
  /// zona horaria.
  startDate     DateTime    @db.Date
  numberOfWeeks Int
  status        SplitStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  weeks              SplitWeek[]
  participants       SplitParticipant[]
  kpiConfigs         SplitKpiConfig[]
  positionPointRules SplitPositionPointRule[]
  publishedResults   PublishedParticipantWeeklyResult[]
  factions           SplitFaction[]
  professions        SplitProfession[]
  economySettings    SplitEconomySettings?
  equipmentSlots     SplitEquipmentSlot[]
  storeItems         SplitStoreItem[]
  newsItems          NewsItem[]
}

/// Semana de un split. La identidad funcional es splitId + sequenceNumber,
/// nunca el numero de semana ISO del calendario.
model SplitWeek {
  id             String   @id @default(uuid())
  splitId        String
  /// Numero secuencial dentro del split: 1, 2, 3...
  sequenceNumber Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  split                    Split                    @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participantsStartingHere SplitParticipant[]       @relation("ParticipantStartWeek")
  productivityImport       ProductivityImport?
  escalationImport         EscalationImport?
  qualityImport            QualityImport?
  voiceImport              VoiceImport?
  stabilityEntries         StabilityWeeklyEntry[]
  chronomancyEntries       ChronomancyWeeklyEntry[]
  writerEntries            WriterWeeklyEntry[]
  studentEntries           StudentWeeklyEntry[]
  apprenticeEntries        ApprenticeWeeklyEntry[]
  publication              WeekPublication?
  location                 SplitWeekLocation?

  @@unique([splitId, sequenceNumber])
}

/// Participante: relacion entre una persona y un split, con alias y nivel
/// propios de ese split.
model SplitParticipant {
  id                      String           @id @default(uuid())
  splitId                 String
  personId                String
  /// Alias tal como lo escribe el administrador.
  alias                   String
  /// Alias normalizado (minusculas, sin espacios exteriores colapsados)
  /// usado exclusivamente para garantizar unicidad dentro del split.
  aliasNormalized         String
  level                   ParticipantLevel
  /// Numero de semana (dentro de este split) desde la que participa.
  startWeekSequenceNumber Int
  /// Preparado para el futuro cierre de participacion. No se usa todavia.
  endWeekSequenceNumber   Int?
  /// Faccion actual del participante (`0.7.0` / MVP-2A, ver docs/FACTIONS.md).
  /// Nullable para permitir una migracion segura de datos existentes y
  /// splits que todavia no usan facciones; los servicios exigen una
  /// asignacion completa antes de activar un split que ya tiene facciones
  /// creadas (ver docs/DECISIONS.md).
  factionId               String?
  /// Profesion actual del participante dentro de este split (`0.8.0` /
  /// MVP-2B, ver docs/PROFESSIONS_AND_PROFILES.md). Nullable: `null`
  /// mientras el split no usa profesiones, o mientras la persona todavia no
  /// ha elegido antes de la primera publicacion. Una persona tiene como
  /// mucho una profesion en cada split; la profesion pertenece a la
  /// participacion, nunca a `Person`.
  professionId            String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  split      Split                   @relation(fields: [splitId], references: [id], onDelete: Cascade)
  person     Person                  @relation(fields: [personId], references: [id])
  startWeek  SplitWeek               @relation("ParticipantStartWeek", fields: [splitId, startWeekSequenceNumber], references: [splitId, sequenceNumber])
  // Restrict: no se borra fisicamente una faccion mientras tenga participantes asignados (ver docs/FACTIONS.md).
  faction    SplitFaction?           @relation(fields: [factionId], references: [id], onDelete: Restrict)
  // Restrict: no se borra fisicamente una profesion mientras tenga participantes asignados (ver docs/PROFESSIONS_AND_PROFILES.md).
  profession SplitProfession?        @relation(fields: [professionId], references: [id], onDelete: Restrict)
  // Cascade: el avatar no tiene sentido sin su ficha.
  avatar     SplitParticipantAvatar?

  productivityRows   ProductivityWeeklyRow[]
  escalationRows     EscalationWeeklyRow[]
  qualityRows        QualityWeeklyRow[]
  voiceRows          VoiceWeeklyRow[]
  stabilityEntries   StabilityWeeklyEntry[]
  chronomancyEntries ChronomancyWeeklyEntry[]
  writerEntries      WriterWeeklyEntry[]
  studentEntries     StudentWeeklyEntry[]
  apprenticeEntries  ApprenticeWeeklyEntry[]
  publishedResults   PublishedParticipantWeeklyResult[]

  // Economia, inventario y equipo (`0.9.0` / MVP-2D, ver docs/ECONOMY_INVENTORY_AND_EQUIPMENT.md).
  ownedItems    SplitParticipantItem[]
  equippedItems SplitParticipantEquippedItem[]
  purchases     ItemPurchase[]
  ledgerEntries CreditLedgerEntry[]

  // Una persona solo puede aparecer una vez en un mismo split.
  @@unique([splitId, personId])
  // El alias normalizado debe ser unico dentro del split (no entre splits).
  @@unique([splitId, aliasNormalized])
  @@index([factionId])
  @@index([professionId])
}

/// Profesion de un split (`0.8.0` / MVP-2B, ver
/// docs/PROFESSIONS_AND_PROFILES.md). Es una capa opcional por split: si el
/// administrador no crea ninguna, el split se comporta exactamente como en
/// `0.7.0`. Cada profesion declara exactamente dos KPI distintos del
/// catalogo cerrado y los niveles tecnicos para los que esta disponible. El
/// porcentaje de bonus no se guarda aqui: es una constante unica del
/// dominio (`PROFESSION_BONUS_PERCENT`, `src/domain/profession-bonus.ts`),
/// siempre `+20 %` despues del maximo base. Nunca se guardan formulas,
/// expresiones ni JSON libre enviado por el navegador.
model SplitProfession {
  id             String   @id @default(uuid())
  splitId        String
  name           String
  /// Nombre normalizado (minusculas, sin espacios exteriores), unico dentro del split.
  nameNormalized String
  /// Primer KPI potenciado. Siempre distinto de `kpiCodeB` (restriccion de base de datos).
  kpiCodeA       KpiCode
  /// Segundo KPI potenciado.
  kpiCodeB       KpiCode
  /// Disponibilidad por nivel tecnico. Al menos uno debe ser `true` (restriccion de base de datos).
  availableN0    Boolean  @default(false)
  availableN1    Boolean  @default(false)
  availableN2    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  split            Split                              @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participants     SplitParticipant[]
  publishedResults PublishedParticipantWeeklyResult[]

  @@unique([splitId, nameNormalized])
}

/// Avatar de una participacion de split (`0.8.0` / MVP-2B, ver
/// docs/PROFESSIONS_AND_PROFILES.md). Entidad uno-a-uno separada de
/// `SplitParticipant` a proposito: los bytes nunca deben cargarse en los
/// listados de participantes, fichas o resultados, solo cuando el navegador
/// pide realmente la imagen. La imagen se guarda ya procesada y normalizada
/// (WebP, maximo 512 px por lado, sin EXIF ni metadatos del original).
model SplitParticipantAvatar {
  /// Clave primaria y unica: como mucho un avatar por participacion.
  splitParticipantId String   @id
  /// Bytes de la imagen ya procesada (nunca el original subido).
  imageData          Bytes
  /// MIME final real de `imageData` (siempre `image/webp` en esta entrega).
  mimeType           String
  /// Tamano en bytes de `imageData`. No negativo (restriccion de base de datos).
  byteSize           Int
  /// SHA-256 de `imageData`: version estable usada como `ETag` de cache.
  sha256             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Cascade)
}

/// Faccion de un split (`0.7.0` / MVP-2A, ver docs/FACTIONS.md). Cada
/// faccion pertenece a un unico split; un split necesita al menos dos para
/// considerarse "configurado" con facciones. No es una segunda entidad de
/// renombre: el aporte de cada participante a su faccion es exactamente su
/// `positionPoints` ya publicado.
model SplitFaction {
  id             String   @id @default(uuid())
  splitId        String
  name           String
  /// Nombre normalizado (minusculas, sin espacios exteriores), unico dentro del split.
  nameNormalized String
  /// Color hexadecimal `#RRGGBB`, validado en servicio. Solo es una ayuda visual: no es unico.
  color          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  split            Split                              @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participants     SplitParticipant[]
  publishedResults PublishedParticipantWeeklyResult[]

  @@unique([splitId, nameNormalized])
}

/// Configuracion de un KPI del catalogo cerrado para un split concreto.
/// Cada split conserva su propia copia: un cambio futuro en los valores
/// predeterminados del catalogo no modifica silenciosamente la
/// configuracion de splits ya creados.
model SplitKpiConfig {
  id           String   @id @default(uuid())
  splitId      String
  kpiCode      KpiCode
  isActive     Boolean  @default(false)
  /// Maximo base del KPI. Siempre mayor que cero.
  baseMax      Decimal  @db.Decimal(12, 4)
  /// Multiplicador aplicado a participantes de nivel N0. `null` significa
  /// que el nivel no es aplicable para este KPI, no que el multiplicador
  /// sea cero.
  multiplierN0 Decimal? @db.Decimal(12, 4)
  multiplierN1 Decimal? @db.Decimal(12, 4)
  multiplierN2 Decimal? @db.Decimal(12, 4)
  /// Parametros propios del tipo de calculo de este KPI (ver
  /// src/domain/kpis/catalog.ts). Nunca se acepta tal cual desde el
  /// navegador: se construye a partir de campos conocidos y se valida
  /// segun `kpiCode` antes de guardarse.
  parameters   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  split Split @relation(fields: [splitId], references: [id], onDelete: Cascade)

  // Un split tiene como mucho una configuracion por cada KPI del catalogo.
  @@unique([splitId, kpiCode])
}

/// Carga semanal del Excel de Productividad para una semana de un split
/// (ver docs/IMPORT_PRODUCTIVITY.md). Un unico archivo alimenta los KPI
/// "Cazador de soluciones" y "Explorador de datos". El binario del Excel
/// nunca se guarda: `fileSha256` solo identifica el archivo procesado, no
/// se usa para deducir la semana.
model ProductivityImport {
  id               String   @id @default(uuid())
  /// Como mucho una carga de Productividad vigente por semana.
  splitWeekId      String   @unique
  originalFilename String
  fileSha256       String
  sourceRowCount   Int
  importedRowCount Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  splitWeek SplitWeek               @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  rows      ProductivityWeeklyRow[]
}

/// Fila de productividad de un participante encontrado en la carga
/// semanal. Los siete conteos son los valores fuente del Excel; los
/// puntos de Cazador de soluciones y Explorador de datos no se guardan
/// aqui, se calculan al consultar (ver docs/DECISIONS.md).
model ProductivityWeeklyRow {
  id                        String   @id @default(uuid())
  productivityImportId      String
  splitParticipantId        String
  /// Nombre tal como aparecia en la columna "Nombre del actualizador" del
  /// Excel, conservado para trazabilidad.
  sourceAgentName           String
  /// Conservado para el futuro calculo de Domador de Escaladas.
  updates                   Int
  comments                  Int
  publicComments            Int
  internalComments          Int
  ticketsUpdatedWithComment Int
  ticketsResolved           Int
  ticketsCreated            Int
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  productivityImport ProductivityImport @relation(fields: [productivityImportId], references: [id], onDelete: Cascade)
  // Restrict: una fila de productividad nunca debe desaparecer por borrar
  // accidentalmente el participante al que pertenece.
  splitParticipant   SplitParticipant   @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  // Una carga solo puede contener una fila por participante.
  @@unique([productivityImportId, splitParticipantId])
}

/// Carga semanal del Excel de Escalados para una semana de un split (ver
/// docs/IMPORT_ESCALATIONS_QUALITY_VOICE.md). Alimenta, junto con
/// `ProductivityWeeklyRow.updates` de la misma semana y participante, el
/// KPI "Domador de Escaladas". El binario del Excel nunca se guarda.
model EscalationImport {
  id               String   @id @default(uuid())
  /// Como mucho una carga de Escalados vigente por semana.
  splitWeekId      String   @unique
  originalFilename String
  fileSha256       String
  sourceRowCount   Int
  importedRowCount Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  splitWeek SplitWeek             @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  rows      EscalationWeeklyRow[]
}

/// Fila de Escalados de un participante encontrado en la carga semanal.
/// El numerador de Domador de Escaladas; el denominador (`updates`) se lee
/// de `ProductivityWeeklyRow` de la misma semana, no se duplica aqui.
model EscalationWeeklyRow {
  id                 String   @id @default(uuid())
  escalationImportId String
  splitParticipantId String
  /// Nombre tal como aparecia en la columna "Nombre del actualizador".
  sourceAgentName    String
  groupReassignments Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  escalationImport EscalationImport @relation(fields: [escalationImportId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([escalationImportId, splitParticipantId])
}

/// Carga semanal del Excel de Calidad para una semana de un split.
/// Alimenta el KPI "Maestro Artesano". El binario del Excel nunca se guarda.
model QualityImport {
  id               String   @id @default(uuid())
  /// Como mucho una carga de Calidad vigente por semana.
  splitWeekId      String   @unique
  originalFilename String
  fileSha256       String
  sourceRowCount   Int
  importedRowCount Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  splitWeek SplitWeek          @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  rows      QualityWeeklyRow[]
}

/// Fila de Calidad de un participante encontrado en la carga semanal.
model QualityWeeklyRow {
  id                      String   @id @default(uuid())
  qualityImportId         String
  splitParticipantId      String
  /// Nombre tal como aparecia en la columna "Nombre del agente asignado".
  sourceAgentName         String
  goodSatisfactionTickets Int
  badSatisfactionTickets  Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  qualityImport    QualityImport    @relation(fields: [qualityImportId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([qualityImportId, splitParticipantId])
}

/// Carga semanal del Excel de Llamadas para una semana de un split.
/// Alimenta el KPI "Embajador de voz". El binario del Excel nunca se guarda.
model VoiceImport {
  id               String   @id @default(uuid())
  /// Como mucho una carga de Llamadas vigente por semana.
  splitWeekId      String   @unique
  originalFilename String
  fileSha256       String
  sourceRowCount   Int
  importedRowCount Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  splitWeek SplitWeek        @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  rows      VoiceWeeklyRow[]
}

/// Fila de Llamadas de un participante encontrado en la carga semanal. Las
/// cuatro primeras metricas puntuan Embajador de voz; las cinco de tiempo
/// se conservan solo para trazabilidad (ver
/// docs/IMPORT_ESCALATIONS_QUALITY_VOICE.md).
model VoiceWeeklyRow {
  id                       String   @id @default(uuid())
  voiceImportId            String
  splitParticipantId       String
  /// Nombre tal como aparecia en la columna "Agente del segmento - Nombre".
  sourceAgentName          String
  acceptedCallSegments     Int
  rejectedCallSegments     Int
  unattendedCallSegments   Int
  outboundCalls            Int
  segmentDurationHours     Decimal  @db.Decimal(14, 6)
  segmentTalkTimeHours     Decimal  @db.Decimal(14, 6)
  segmentWrapUpTimeHours   Decimal  @db.Decimal(14, 6)
  segmentTalkTimeMinutes   Decimal  @db.Decimal(14, 6)
  segmentWrapUpTimeMinutes Decimal  @db.Decimal(14, 6)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  voiceImport      VoiceImport      @relation(fields: [voiceImportId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([voiceImportId, splitParticipantId])
}

/// Entrada manual semanal de Guardian de la Estabilidad (`STABILITY_GUARDIAN`,
/// ver docs/MANUAL_KPI_ENTRY.md). Sin fichero ni cabecera de carga: el
/// administrador escribe directamente una fila por participante y semana.
/// Solo aplica a participantes N2, pero el modelo no restringe el nivel: la
/// aplicabilidad se valida en el servicio.
model StabilityWeeklyEntry {
  id                 String   @id @default(uuid())
  splitWeekId        String
  splitParticipantId String
  /// Resultado de estabilidad. Un valor 0 es un dato real, no vacaciones.
  resultValue        Decimal  @db.Decimal(12, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  splitWeek        SplitWeek        @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([splitWeekId, splitParticipantId])
}

/// Entrada manual semanal de Cronomagia laboral (`WORK_CHRONOMANCY`, ver
/// docs/MANUAL_KPI_ENTRY.md y, desde `1.1.1`,
/// docs/WEEKLY_ATTENDANCE_AND_HOURS.md). `totalHours` es ahora tambien el
/// unico dato operativo de asistencia semanal (`totalHours = 0` significa
/// ausencia, con prioridad sobre cualquier otro KPI), independiente de si
/// `WORK_CHRONOMANCY` esta activo. `productiveHours` es nullable desde
/// `1.1.1`: solo se captura cuando el KPI esta activo y aplica al nivel del
/// participante; `null` significa "no aplica", nunca "vacaciones" ni cero
/// implicito.
model ChronomancyWeeklyEntry {
  id                 String   @id @default(uuid())
  splitWeekId        String
  splitParticipantId String
  productiveHours    Decimal? @db.Decimal(12, 4)
  totalHours         Decimal  @db.Decimal(12, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  splitWeek        SplitWeek        @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([splitWeekId, splitParticipantId])
}

/// Entrada manual semanal de Redactor estrella (`STAR_WRITER`, ver
/// docs/MANUAL_KPI_ENTRY.md). Los articulos no entregados se escriben como
/// conteo positivo; el calculo aplica la resta.
model WriterWeeklyEntry {
  id                  String   @id @default(uuid())
  splitWeekId         String
  splitParticipantId  String
  deliveredArticles   Int
  undeliveredArticles Int
  proposedArticles    Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  splitWeek        SplitWeek        @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([splitWeekId, splitParticipantId])
}

/// Entrada manual semanal de Estudiante entusiasta (`ENTHUSIASTIC_STUDENT`,
/// ver docs/MANUAL_KPI_ENTRY.md).
model StudentWeeklyEntry {
  id                 String   @id @default(uuid())
  splitWeekId        String
  splitParticipantId String
  dedicatedHours     Decimal  @db.Decimal(12, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  splitWeek        SplitWeek        @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([splitWeekId, splitParticipantId])
}

/// Puntos por posicion semanal de un split (`BUGFIX-1 / UX-SPLIT-1`, ver
/// docs/POSITION_POINTS_CONFIGURATION.md). Existen exactamente las
/// posiciones 1..15 por split, cada una con su propio valor de puntos.
/// Esta entrega solo guarda la configuracion: no calcula posiciones
/// semanales ni reparte estos puntos, y no es un KPI ni cuenta como uno.
/// Cada split conserva su propia copia (igual que `SplitKpiConfig`): editar
/// uno no afecta a los demas.
model SplitPositionPointRule {
  id        String   @id @default(uuid())
  splitId   String
  /// Posicion semanal (1 a 15). Restriccion de base de datos.
  position  Int
  /// Puntos otorgados a esa posicion. Nunca negativo.
  points    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  split Split @relation(fields: [splitId], references: [id], onDelete: Cascade)

  @@unique([splitId, position])
}

/// Entrada manual semanal de Aprendiz experto (`EXPERT_APPRENTICE`, ver
/// docs/MANUAL_KPI_ENTRY.md). El maximo permitido (`targetValue` de
/// `SplitKpiConfig`) se valida en el servicio, no en la base de datos: el
/// valor configurado puede cambiar despues de guardar una entrada.
model ApprenticeWeeklyEntry {
  id                 String   @id @default(uuid())
  splitWeekId        String
  splitParticipantId String
  completedTrainings Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  splitWeek        SplitWeek        @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  splitParticipant SplitParticipant @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)

  @@unique([splitWeekId, splitParticipantId])
}

enum PublishedKpiOutcomeStatus {
  COMPUTED
  VAC
  NOT_APPLICABLE
  /// KPI aplicable de una persona ausente esa semana (`1.1.1`, ver
  /// docs/WEEKLY_ATTENDANCE_AND_HOURS.md). Distinto de `VAC` (dato ausente
  /// de una persona presente) y de `NOT_APPLICABLE` (KPI ajeno al nivel).
  ABSENT
}

/// Asistencia semanal de una persona (`1.1.1`, ver
/// docs/WEEKLY_ATTENDANCE_AND_HOURS.md): se determina exclusivamente por
/// `totalHours` de la captura semanal de horas (`ChronomancyWeeklyEntry`),
/// nunca por otro KPI, VAC, creditos o nivel. `PRESENT` = `totalHours > 0`;
/// `ABSENT` = `totalHours = 0` (o fila guardada vacia, normalizada a 0).
enum WeeklyAttendanceStatus {
  PRESENT
  ABSENT
}

/// Publicacion de una semana (`0.6.0` / MVP-1C, ver
/// docs/RESULTS_PUBLICATION.md): operacion de dominio irreversible que crea
/// una instantanea inmutable de los resultados y bloquea cualquier
/// modificacion posterior de las entradas de esa semana. Es la unica fuente
/// de verdad de que una semana esta publicada; no se mezcla con
/// `SplitStatus.CLOSED`, que cierra el split completo. No existe
/// despublicar, reabrir ni borrar una publicacion en esta entrega.
model WeekPublication {
  id                           String   @id @default(uuid())
  /// Como mucho una publicacion por semana.
  splitWeekId                  String   @unique
  publishedAt                  DateTime @default(now())
  publishedByUserId            String?
  /// Localizacion semanal congelada (`0.8.5` / MVP-2C, ver
  /// docs/WEEKLY_LOCATIONS.md). Los cuatro campos son `null` cuando la
  /// semana no tenia localizacion o en publicaciones anteriores a esta
  /// version: nunca se completan retroactivamente. Como la localizacion es
  /// unica y comun a toda la semana, se congela una sola vez aqui en vez de
  /// repetirla en cada fila de participante.
  locationId                   String?
  locationNameSnapshot         String?
  locationKpiCodeSnapshot      KpiCode?
  locationBonusPercentSnapshot Int?
  createdAt                    DateTime @default(now())

  splitWeek          SplitWeek                          @relation(fields: [splitWeekId], references: [id], onDelete: Restrict)
  publishedByUser    User?                              @relation(fields: [publishedByUserId], references: [id])
  // SetNull defensivo: una localizacion referenciada por una publicacion nunca deberia poder
  // borrarse (la ventana temporal ya lo impide), pero si ocurriera no debe arrastrar la publicacion.
  location           SplitWeekLocation?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  participantResults PublishedParticipantWeeklyResult[]
}

/// Localizacion semanal (`0.8.5` / MVP-2C, ver docs/WEEKLY_LOCATIONS.md):
/// capa de juego opcional, con cero o una localizacion por `SplitWeek`.
/// Afecta por igual a todos los participantes aplicables de la semana en un
/// unico KPI activo, con un bonus posterior al maximo base (igual que la
/// profesion, pero sin encadenarse con ella). No hay catalogo global: cada
/// semana declara su propio nombre, KPI y porcentaje.
model SplitWeekLocation {
  id           String   @id @default(uuid())
  /// Como mucho una localizacion por semana: la identidad funcional siempre
  /// es `splitWeekId`, nunca un numero de semana ISO ni un texto libre.
  splitWeekId  String   @unique
  name         String
  /// KPI potenciado. Debe estar activo en el split al crear o editar la
  /// localizacion (comprobado en servicio, no solo en el selector).
  kpiCode      KpiCode
  /// Porcentaje del bonus: unicamente 10, 20, 30, 40 o 50 (restriccion de
  /// base de datos `SplitWeekLocation_bonusPercent_allowed_check`).
  bonusPercent Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  splitWeek    SplitWeek         @relation(fields: [splitWeekId], references: [id], onDelete: Cascade)
  publications WeekPublication[]
}

/// Fila congelada de un participante en una semana publicada: nombre,
/// alias, nivel, totales, ranking y puntos por posicion tal como eran en el
/// momento de publicar. Un cambio posterior en `SplitParticipant`,
/// `Person`, `SplitKpiConfig` o `SplitPositionPointRule` nunca modifica
/// esta fila. `splitId` esta desnormalizado desde `splitParticipant` para
/// poder consultar la clasificacion de un split con un numero acotado de
/// consultas, sin recorrer `publication -> splitWeek -> split` por fila.
model PublishedParticipantWeeklyResult {
  id                      String                  @id @default(uuid())
  publicationId           String
  splitId                 String
  splitParticipantId      String
  personId                String
  fullNameSnapshot        String
  aliasSnapshot           String
  levelSnapshot           ParticipantLevel
  /// Suma de `finalPoints` de los KPI activos de la semana. Puede ser negativa.
  totalKpiPoints          Decimal                 @db.Decimal(14, 4)
  /// Suma de `baseMax` de los KPI en estado `COMPUTED`. `null` si ninguno lo estuvo.
  applicableMaxPoints     Decimal?                @db.Decimal(14, 4)
  /// Posicion semanal entre presentes. `null` para una persona ausente esa
  /// semana, o cuando ningun participante aplicable estuvo presente
  /// (`1.1.1`, ver docs/WEEKLY_ATTENDANCE_AND_HOURS.md): una ausencia nunca
  /// ocupa ni consume un ordinal.
  weeklyRank              Int?
  positionPoints          Int
  /// Numero total de participantes que entraron en el ranking semanal (denominador de "x de n").
  rankedParticipantCount  Int
  /// Asistencia semanal congelada (`1.1.1`). `null` en publicaciones
  /// anteriores a esta version: no se completa retroactivamente.
  attendanceStatus        WeeklyAttendanceStatus?
  /// Horas totales de la semana, congeladas (`1.1.1`). `null` en
  /// publicaciones anteriores a esta version.
  totalHoursSnapshot      Decimal?                @db.Decimal(12, 4)
  /// Horas productivas congeladas cuando existian (`1.1.1`). `null` cuando
  /// no se capturaron (Cronomagia inactiva o no aplicable al nivel) o en
  /// publicaciones anteriores a esta version.
  productiveHoursSnapshot Decimal?                @db.Decimal(12, 4)
  /// Posicion realmente usada para conceder los puntos por posicion
  /// (`1.1.1`): coincide con `weeklyRank` para un presente; para un
  /// ausente es la ultima posicion efectivamente ocupada por una persona
  /// presente esa semana. `null` cuando no hubo ninguna persona presente.
  positionPointsRuleRank  Int?
  /// Faccion congelada del participante en el momento de publicar (`0.7.0` /
  /// MVP-2A, ver docs/FACTIONS.md). `null` para splits que no usan facciones
  /// o para publicaciones anteriores a esta version: quedan excluidas de la
  /// clasificacion de facciones, sin recalculo retroactivo.
  factionId               String?
  factionNameSnapshot     String?
  factionColorSnapshot    String?
  /// Profesion congelada del participante en el momento de publicar (`0.8.0` /
  /// MVP-2B, ver docs/PROFESSIONS_AND_PROFILES.md). Los cuatro campos son
  /// `null` cuando el split no usa profesiones o en publicaciones anteriores
  /// a esta version: nunca se completan retroactivamente.
  professionId            String?
  professionNameSnapshot  String?
  professionKpiCodeA      KpiCode?
  professionKpiCodeB      KpiCode?
  /// Porcentaje de bonus congelado (siempre `20` cuando hay profesion).
  professionBonusPercent  Int?
  /// `true` si el split usaba profesiones al publicar esta semana. `false`
  /// en publicaciones anteriores a `0.8.0` y en splits sin profesiones: es
  /// lo que permite distinguir "sin profesiones" de "profesion desconocida".
  splitUsedProfessions    Boolean                 @default(false)
  /// Creditos ganados por esta fila publicada (`0.9.0` / MVP-2D, ver
  /// docs/ECONOMY_INVENTORY_AND_EQUIPMENT.md): `max(0, floor(totalKpiPoints))`,
  /// congelado en la misma transaccion que crea el movimiento `WEEKLY_EARNING`
  /// vinculado. El libro de movimientos sigue siendo la fuente economica; este
  /// campo es la instantanea legible sin tener que sumar el libro.
  creditsEarned           Int                     @default(0)
  createdAt               DateTime                @default(now())

  publication      WeekPublication         @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  split            Split                   @relation(fields: [splitId], references: [id], onDelete: Restrict)
  splitParticipant SplitParticipant        @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)
  person           Person                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  faction          SplitFaction?           @relation(fields: [factionId], references: [id], onDelete: Restrict)
  profession       SplitProfession?        @relation(fields: [professionId], references: [id], onDelete: Restrict)
  kpiResults       PublishedKpiResult[]
  equippedItems    PublishedEquippedItem[]
  ledgerEntry      CreditLedgerEntry?

  // Un solo resultado por participante y publicacion (equivale a una vez por semana, ya que la publicacion es unica por semana).
  @@unique([publicationId, splitParticipantId])
  @@index([personId])
  @@index([splitId])
  @@index([splitParticipantId])
  @@index([factionId])
  @@index([professionId])
}

/// Resultado congelado de un KPI para un participante publicado: estado
/// funcional, puntos y ranking dentro de ese KPI tal como eran al publicar.
model PublishedKpiResult {
  id                         String                    @id @default(uuid())
  participantWeeklyResultId  String
  kpiCode                    KpiCode
  kpiNameSnapshot            String
  outcomeStatus              PublishedKpiOutcomeStatus
  rawPoints                  Decimal?                  @db.Decimal(14, 4)
  /// Puntos definitivos, ya con el bonus de profesion incluido desde
  /// `0.8.0`. En publicaciones anteriores coincide con los puntos tras el
  /// maximo base, porque entonces no existia ningun bonus.
  finalPoints                Decimal?                  @db.Decimal(14, 4)
  baseMax                    Decimal?                  @db.Decimal(14, 4)
  capped                     Boolean                   @default(false)
  /// Puntos tras aplicar el maximo base y **antes** del bonus de profesion
  /// (`0.8.0` / MVP-2B). `null` en publicaciones anteriores a esta version.
  basePointsBeforeProfession Decimal?                  @db.Decimal(14, 4)
  /// Puntos anadidos por la profesion (`baseFinalPoints x 0,20`). `null` en
  /// publicaciones anteriores; `0` cuando la profesion no aplica a este KPI.
  professionBonusPoints      Decimal?                  @db.Decimal(14, 4)
  /// `true` solo si el bonus se aplico realmente a este KPI.
  professionApplied          Boolean                   @default(false)
  /// Nombre de la profesion que produjo el bonus, congelado para poder
  /// explicar el efecto sin consultar la definicion actual.
  professionNameSnapshot     String?
  /// Puntos anadidos por la localizacion semanal (`0.8.5` / MVP-2C, ver
  /// docs/WEEKLY_LOCATIONS.md), calculados sobre el mismo
  /// `basePointsBeforeProfession` que la profesion, nunca encadenados entre
  /// si. `null` en publicaciones anteriores; `0` cuando no aplica.
  locationBonusPoints        Decimal?                  @db.Decimal(14, 4)
  /// `true` solo si el bonus de localizacion se aplico realmente a este KPI.
  locationApplied            Boolean                   @default(false)
  /// Suma de los puntos anadidos por todos los objetos de equipo que
  /// potencian este KPI (`0.9.0` / MVP-2D), calculados sobre el mismo
  /// `basePointsBeforeProfession` que profesion y localizacion, nunca
  /// encadenados entre si. `null` en publicaciones anteriores; `0` cuando
  /// no aplica ningun objeto. El desglose por objeto vive en
  /// `PublishedEquippedItem`, filtrado por `kpiCodeSnapshot`.
  equipmentBonusPoints       Decimal?                  @db.Decimal(14, 4)
  /// `true` solo si al menos un objeto equipado aplico su bonus a este KPI.
  equipmentApplied           Boolean                   @default(false)
  kpiRank                    Int?
  rankedParticipantCount     Int?
  createdAt                  DateTime                  @default(now())

  participantWeeklyResult PublishedParticipantWeeklyResult @relation(fields: [participantWeeklyResultId], references: [id], onDelete: Cascade)

  // Un solo resultado por KPI y participante publicado.
  @@unique([participantWeeklyResultId, kpiCode])
}

// ---------------------------------------------------------------------------
// Economia, inventario y equipo (`0.9.0` / MVP-2D, ver
// docs/ECONOMY_INVENTORY_AND_EQUIPMENT.md). Cuarta capa de juego: creditos por
// split, mercado administrable, catalogo de objetos, inventario personal,
// ranuras de equipo configurables y un tercer bonus (junto a profesion y
// localizacion) sobre el mismo `baseFinalPoints`, nunca encadenado con ellos.
// ---------------------------------------------------------------------------

enum MarketStatus {
  CLOSED
  OPEN
}

/// Estado del mercado de un split (uno-a-uno). Todo split nuevo o ya
/// existente antes de esta version empieza `CLOSED`: el administrador debe
/// abrirlo explicitamente una vez preparadas ranuras y objetos (seccion 6
/// del encargo).
model SplitEconomySettings {
  splitId      String       @id
  marketStatus MarketStatus @default(CLOSED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  split Split @relation(fields: [splitId], references: [id], onDelete: Cascade)
}

/// Ranura de equipo configurable por split (seccion 10 del encargo): nombre y
/// cantidad los decide el administrador, sin ranuras codificadas. Cada
/// objeto pertenece exactamente a una ranura del mismo split, y cada
/// participante puede equipar como maximo un objeto por ranura.
model SplitEquipmentSlot {
  id             String   @id @default(uuid())
  splitId        String
  name           String
  /// Nombre normalizado (minusculas, sin espacios exteriores), unico dentro del split.
  nameNormalized String
  /// Orden de presentacion, no negativo. No implica limite de ranuras mas alla del tecnico documentado.
  displayOrder   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  split                  Split                          @relation(fields: [splitId], references: [id], onDelete: Cascade)
  storeItems             SplitStoreItem[]
  equippedItems          SplitParticipantEquippedItem[]
  publishedEquippedItems PublishedEquippedItem[]

  @@unique([splitId, nameNormalized])
}

/// Objeto del catalogo de un split (seccion 12 del encargo), creado por el
/// administrador. Sin catalogo global ni objetos predeterminados. Afecta
/// exactamente a un KPI activo del split con un porcentaje del conjunto
/// cerrado (`src/domain/bonus-percent.ts`), y pertenece a una unica ranura
/// del mismo split.
model SplitStoreItem {
  id              String   @id @default(uuid())
  splitId         String
  name            String
  /// Nombre normalizado (minusculas, sin espacios exteriores), unico dentro del split.
  nameNormalized  String
  description     String?
  /// Precio en creditos. Entero positivo (restriccion de base de datos).
  priceCredits    Int
  equipmentSlotId String
  /// KPI potenciado. Debe estar activo en el split al crear o editar el objeto (comprobado en servicio).
  kpiCode         KpiCode
  /// Porcentaje del bonus: unicamente 10, 20, 30, 40 o 50 (misma lista que localizaciones).
  bonusPercent    Int
  /// Si esta disponible para nuevas compras. Retirarlo (`false`) no afecta a quien ya lo posee.
  isForSale       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  split                  Split                   @relation(fields: [splitId], references: [id], onDelete: Cascade)
  // Restrict: no se borra fisicamente una ranura mientras tenga objetos (ver docs/ECONOMY_INVENTORY_AND_EQUIPMENT.md).
  equipmentSlot          SplitEquipmentSlot      @relation(fields: [equipmentSlotId], references: [id], onDelete: Restrict)
  ownedItems             SplitParticipantItem[]
  purchases              ItemPurchase[]
  publishedEquippedItems PublishedEquippedItem[]

  @@unique([splitId, nameNormalized])
  @@index([splitId, equipmentSlotId])
}

/// Compra confirmada de un objeto (seccion 16 del encargo): instantanea
/// inmutable de nombre, precio, ranura, KPI y bonus tal como eran en el
/// momento de comprar, para que una edicion posterior del catalogo nunca
/// altere el efecto de un objeto ya pagado.
model ItemPurchase {
  id                        String   @id @default(uuid())
  splitParticipantId        String
  storeItemId               String
  itemNameSnapshot          String
  priceCreditsSnapshot      Int
  equipmentSlotIdSnapshot   String
  equipmentSlotNameSnapshot String
  kpiCodeSnapshot           KpiCode
  bonusPercentSnapshot      Int
  purchasedAt               DateTime @default(now())

  // Restrict: una compra confirmada es permanente (seccion 17 del encargo); nunca desaparece por borrar el participante o el objeto.
  splitParticipant SplitParticipant      @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)
  storeItem        SplitStoreItem        @relation(fields: [storeItemId], references: [id], onDelete: Restrict)
  ownedItem        SplitParticipantItem?
  ledgerEntry      CreditLedgerEntry?

  // Un participante compra como maximo una unidad de cada objeto (seccion 12 del encargo).
  @@unique([splitParticipantId, storeItemId])
  @@index([splitParticipantId])
}

/// Inventario permanente de un participante (seccion 17 del encargo): un
/// objeto adquirido, su compra de origen y la fecha. Sin reventa, regalo,
/// intercambio ni destruccion en esta release.
model SplitParticipantItem {
  id                 String   @id @default(uuid())
  splitParticipantId String
  storeItemId        String
  purchaseId         String   @unique
  acquiredAt         DateTime @default(now())

  splitParticipant SplitParticipant              @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)
  storeItem        SplitStoreItem                @relation(fields: [storeItemId], references: [id], onDelete: Restrict)
  purchase         ItemPurchase                  @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  equipped         SplitParticipantEquippedItem?

  // Un participante posee como maximo una unidad de cada objeto.
  @@unique([splitParticipantId, storeItemId])
}

/// Equipo actual del participante (seccion 19 del encargo): como mucho un
/// objeto equipado por ranura. La verdad definitiva para una semana es el
/// equipo existente en el instante en que se publica esa semana (releida
/// dentro de la misma transaccion de `publishWeek`), nunca una fecha limite
/// semanal ni el equipo mostrado en una previsualizacion previa.
model SplitParticipantEquippedItem {
  splitParticipantId String
  equipmentSlotId    String
  ownedItemId        String   @unique
  equippedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  splitParticipant SplitParticipant     @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)
  equipmentSlot    SplitEquipmentSlot   @relation(fields: [equipmentSlotId], references: [id], onDelete: Restrict)
  ownedItem        SplitParticipantItem @relation(fields: [ownedItemId], references: [id], onDelete: Restrict)

  // Como mucho un objeto equipado por ranura y participante.
  @@id([splitParticipantId, equipmentSlotId])
}

enum CreditMovementType {
  WEEKLY_EARNING
  PURCHASE
}

/// Libro de movimientos inmutable de creditos (seccion 4 del encargo): unica
/// fuente de verdad del saldo (`balance = suma de todos los movimientos`).
/// Un `WEEKLY_EARNING` se vincula a lo sumo a un `PublishedParticipantWeeklyResult`
/// y un `PURCHASE` a lo sumo a un `ItemPurchase`, ambos con indice unico para
/// impedir duplicados por reintento o carrera. Los movimientos publicados no
/// se editan ni se eliminan.
model CreditLedgerEntry {
  id                 String             @id @default(uuid())
  splitParticipantId String
  type               CreditMovementType
  /// Importe entero con signo: `>= 0` para `WEEKLY_EARNING`, `< 0` para `PURCHASE` (restriccion de base de datos).
  amount             Int
  description        String
  /// Como mucho un movimiento `WEEKLY_EARNING` por resultado semanal publicado.
  publishedResultId  String?            @unique
  /// Como mucho un movimiento `PURCHASE` por compra.
  purchaseId         String?            @unique
  createdAt          DateTime           @default(now())

  // Restrict: ningun movimiento desaparece por borrar accidentalmente al participante, el resultado o la compra.
  splitParticipant SplitParticipant                  @relation(fields: [splitParticipantId], references: [id], onDelete: Restrict)
  publishedResult  PublishedParticipantWeeklyResult? @relation(fields: [publishedResultId], references: [id], onDelete: Restrict)
  purchase         ItemPurchase?                     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([splitParticipantId, createdAt])
}

/// Objeto equipado congelado en una semana publicada (seccion 28 del
/// encargo): una fila por objeto, con nombre, ranura, KPI y porcentaje tal
/// como eran al publicar. `storeItemId`/`equipmentSlotId` se conservan como
/// referencia viva "cuando proceda" (nunca se borran fisicamente objetos ni
/// ranuras referenciados), pero las vistas historicas siempre explican la
/// semana con los campos `*Snapshot`, nunca con el catalogo o las ranuras
/// actuales.
model PublishedEquippedItem {
  id                        String   @id @default(uuid())
  participantWeeklyResultId String
  storeItemId               String?
  itemNameSnapshot          String
  equipmentSlotId           String?
  equipmentSlotNameSnapshot String
  kpiCodeSnapshot           KpiCode
  bonusPercentSnapshot      Int
  displayOrder              Int
  createdAt                 DateTime @default(now())

  participantWeeklyResult PublishedParticipantWeeklyResult @relation(fields: [participantWeeklyResultId], references: [id], onDelete: Cascade)
  // SetNull defensivo, igual que la localizacion congelada en WeekPublication: el snapshot no depende del objeto/ranura vivos.
  storeItem               SplitStoreItem?                  @relation(fields: [storeItemId], references: [id], onDelete: SetNull)
  equipmentSlot           SplitEquipmentSlot?              @relation(fields: [equipmentSlotId], references: [id], onDelete: SetNull)

  @@index([participantWeeklyResultId])
}

// ---------------------------------------------------------------------------
// Centro de noticias (`1.0.0` / MVP-3, ver docs/NEWS_CENTER.md). Dos
// conceptos separados a proposito: `NewsItem` es el contenido (texto plano
// congelado, nunca editable) y `NewsDelivery` es la entrega privada a un
// unico destinatario (una `Person` para noticias de jugador -para que
// lleguen aunque la cuenta todavia no exista-, o un `User` para noticias de
// administracion). No es un motor generico de eventos: cada origen
// automatico declara su propia plantilla en el servicio de negocio que la
// genera; este esquema solo guarda el resultado ya redactado.
// ---------------------------------------------------------------------------

enum NewsOrigin {
  AUTOMATIC
  MANUAL
}

/// Categoria cerrada de noticia (seccion 25 del encargo). Puramente
/// descriptiva (icono + filtro en la bandeja); no condiciona destinatarios
/// ni permisos.
enum NewsCategory {
  SPLIT
  PROFILE
  RESULTS
  FACTION
  PROFESSION
  LOCATION
  MARKET
  PURCHASE
  ANNOUNCEMENT
  ADMIN
}

enum NewsPriority {
  NORMAL
  IMPORTANT
}

/// Contenido inmutable de una noticia. `splitId`/`splitNameSnapshot` son
/// opcionales porque una noticia de administracion puede no pertenecer a
/// ningun split. `eventKey` es la clave de idempotencia de las noticias
/// automaticas repetibles (activacion, publicacion, apertura de mercado...):
/// unica cuando no es `null`, para que una carrera o un reintento nunca
/// duplique la noticia. `createdByUserId` y `manualAudienceSnapshot` solo se
/// usan en envio manual.
model NewsItem {
  id                     String       @id @default(uuid())
  splitId                String?
  splitNameSnapshot      String?
  origin                 NewsOrigin
  category               NewsCategory
  priority               NewsPriority @default(NORMAL)
  title                  String
  body                   String
  eventKey               String?      @unique
  createdByUserId        String?
  /// Descripcion congelada del publico elegido por el administrador (por
  /// ejemplo "Todo el split", "Faccion Aurora" o el alias de una persona).
  /// Solo para envio manual; `null` en noticias automaticas.
  manualAudienceSnapshot String?
  createdAt              DateTime     @default(now())

  split         Split?         @relation(fields: [splitId], references: [id], onDelete: SetNull)
  // Restrict: el autor de un envio manual no se borra fisicamente mientras conserve mensajes enviados.
  createdByUser User?          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries    NewsDelivery[]

  @@index([splitId, category, createdAt])
}

/// Entrega privada de una noticia a un destinatario concreto (seccion 26 del
/// encargo). Exactamente uno entre `recipientPersonId` y `recipientUserId`
/// (restriccion `NewsDelivery_recipient_exclusive_check` en la migracion).
/// Solo `readAt`/`archivedAt` cambian despues de crearse; no hay borrado
/// fisico desde la interfaz. `actionPath` se construye siempre en servidor
/// (`src/domain/news-links.ts`), nunca a partir de una URL enviada por el
/// administrador.
model NewsDelivery {
  id                String    @id @default(uuid())
  newsItemId        String
  recipientPersonId String?
  recipientUserId   String?
  actionPath        String?
  readAt            DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())

  newsItem        NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  // Restrict: una entrega ya creada nunca debe quedar huerfana por borrar fisicamente al destinatario.
  recipientPerson Person?  @relation(fields: [recipientPersonId], references: [id], onDelete: Restrict)
  recipientUser   User?    @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)

  // Como mucho una entrega de cada noticia por persona (Postgres no considera iguales dos NULL, por lo que esto no bloquea las entregas dirigidas a un usuario).
  @@unique([newsItemId, recipientPersonId])
  // Como mucho una entrega de cada noticia por usuario directo.
  @@unique([newsItemId, recipientUserId])
  @@index([recipientPersonId, archivedAt, readAt, createdAt])
  @@index([recipientUserId, archivedAt, readAt, createdAt])
}
