# Copia este archivo como ".env" y ajusta los valores para tu entorno local.
# No incluyas secretos reales en este archivo de ejemplo.

# Cadena de conexion a PostgreSQL utilizada por Prisma.
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:Bateman37*@localhost:5432/gamification_vcs?schema=public"

# Secreto usado por Auth.js/NextAuth para firmar la sesion (JWT) y las
# cookies. Genera uno propio y distinto para cada entorno, por ejemplo con
# "openssl rand -base64 32" (Linux/macOS/WSL) o "npx auth secret" (Windows
# PowerShell). No reutilices este valor ni lo compartas: no es un secreto
# real, es solo un ejemplo de formato.
AUTH_SECRET="cambia-este-valor-por-un-secreto-generado-localmente"

# Variables solo para "npm run db:create-admin" (ver docs/AUTHENTICATION.md).
# No las dejes definidas de forma permanente en ".env": exportalas en la
# sesion de terminal justo antes de ejecutar el script.
# ADMIN_EMAIL="admin@ejemplo.com"
# ADMIN_PASSWORD="una-contrasena-temporal-segura"
